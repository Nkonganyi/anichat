PORT=4000

# Get this from your database provider (see README) — it looks like:
# postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://anichat:anichat_dev@localhost:5432/anichat

# Any long random string — used to sign login tokens. Change this to your own random text.
JWT_SECRET=change_this_to_a_long_random_string

# Optional — needed only for GIF search/sending. Get a free key from
# https://developers.giphy.com (see README for steps).
# Leave blank and everything else still works fine, GIF search just won't.
GIPHY_API_KEY=
